{
  "id": "root",
  "type": "row",
  "titlebar": "none",
  "traffic_lights": [
    14,
    17
  ],
  "background": "canvas",
  "colors": {
    "background": "#060407",
    "canvas": "#060407",
    "chrome": "#100A0F",
    "surface": "#20161e",
    "raised": "#241822",
    "popover": "#241822",
    "selected": "#28121E",
    "hover": "#28121E",
    "border": "#2A1720",
    "input": "#563040",
    "foreground": "#f6eff3",
    "muted": "#a78e9b",
    "dim": "#76616b",
    "accent": "#f095c8",
    "accent_foreground": "#1a1218",
    "solid": "#f095c8",
    "solid_foreground": "#1a1218",
    "done": "#b4e7c7",
    "blocked": "#e0c27a",
    "working": "#a9c7ee",
    "idle": "#a78e9b",
    "selection": "#f095c84d"
  },
  "terminal_padding": [
    14,
    12
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "size": {
        "px": 251
      },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false,
      "children": [
        {
          "id": "brand",
          "type": "block",
          "size": {
            "px": 46
          },
          "window_drag": true,
          "content": {
            "mod": "gentle-sidebar",
            "props": {
              "part": "brand"
            }
          }
        },
        {
          "id": "spaces",
          "type": "block",
          "size": {
            "px": 200.25
          },
          "min": 54,
          "content": {
            "mod": "gentle-spaces"
          }
        },
        {
          "id": "agents",
          "type": "block",
          "size": {
            "weight": 1
          },
          "min": 60,
          "content": {
            "mod": "gentle-agents"
          }
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "size": {
            "px": 111
          },
          "content": {
            "mod": "gentle-sidebar",
            "props": {
              "part": "usage"
            }
          }
        }
      ]
    },
    {
      "id": "work",
      "type": "column",
      "resizable": false,
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "size": {
            "px": 42
          },
          "window_drag": true,
          "content": {
            "mod": "gentle-tabs"
          }
        },
        {
          "id": "work-body",
          "type": "row",
          "padding": 8,
          "gap": 8,
          "children": [
            {
              "id": "views",
              "type": "stack",
              "active": "chat",
              "children": [
                {
                  "id": "chat",
                  "title": "Chat",
                  "type": "block",
                  "radius": 10,
                  "background": "background",
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "content": {
                    "mod": "gentle-chat",
                    "props": {
                      "stack": "views",
                      "self": "chat",
                      "other": "main"
                    }
                  }
                },
                {
                  "id": "main",
                  "type": "block",
                  "content": {
                    "tab": "active",
                    "pane": {
                      "gap": 8,
                      "radius": 10,
                      "background": "background",
                      "lone": true,
                      "border": {
                        "width": 1,
                        "color": "border"
                      },
                      "focus": {
                        "width": 1,
                        "color": "accent"
                      },
                      "header": {
                        "content": {
                          "mod": "pane"
                        },
                        "height": 30,
                        "position": "top",
                        "reveal": "always"
                      }
                    }
                  },
                  "title": "Terminal"
                }
              ]
            },
            {
              "id": "panel",
              "type": "column",
              "size": {
                "px": 372
              },
              "min": 280,
              "max": 900,
              "radius": 10,
              "background": "chrome",
              "border": {
                "width": 1,
                "color": "border"
              },
              "children": [
                {
                  "id": "inspector",
                  "type": "block",
                  "content": {
                    "mod": "gentle-inspector"
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "status",
          "type": "block",
          "size": {
            "px": 28
          },
          "content": {
            "mod": "gentle-status"
          }
        }
      ]
    }
  ]
}
