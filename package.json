{
	"name": "gentle-pi",
	"version": "3.7.0",
	"description": "Turn Pi into el Gentleman: an ODD development harness with focused subagents, configured TDD evidence, native review, and skill discovery.",
	"license": "MIT",
	"type": "module",
	"bin": {
		"gentle-shell": "bin/gentle-shell.mjs"
	},
	"keywords": [
		"pi-package",
		"pi",
		"pi-coding-agent",
		"gentle-pi",
		"gentle-ai",
		"odd",
		"subagents",
		"tdd",
		"code-review",
		"ai-coding-agent",
		"agent-harness"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Gentleman-Programming/gentle-shell.git"
	},
	"files": [
		"assets/",
		"bin/",
		"contracts/",
		"docs/",
		"extensions/",
		"lib/",
		"prompts/",
		"runtime/",
		"skills/",
		"scripts/",
		"tests/",
		"!tests/fixtures/legacy/sdd-research-v2.5.0.md",
		"themes/",
		"README.md"
	],
	"scripts": {
		"check:provider-contract": "node scripts/check-provider-contract.mjs",
		"mirror:odd-routing": "node scripts/mirror-odd-routing.mjs",
		"postinstall": "node scripts/install-gentle-ai.mjs",
		"test": "node scripts/run-test-suite.mjs",
		"test:harness": "node --experimental-strip-types tests/runtime-harness.mjs",
		"test:dev-binary": "node --experimental-strip-types --test tests/devbinary/*.devtest.ts",
		"test:cross-lane": "node tests/crosslane/cross-lane.mjs",
		"test:maintainer": "node --experimental-strip-types --test tests/maintainer/*.maintest.ts",
		"build:runtime-modules": "node scripts/build-runtime-modules.mjs --write",
		"check:runtime-modules": "node scripts/build-runtime-modules.mjs --check",
		"test:packed-package": "node scripts/test-packed-runner.mjs",
		"prepack": "pnpm test && pnpm run check:runtime-modules && node scripts/verify-package-files.mjs",
		"prepublishOnly": "pnpm test && pnpm run check:runtime-modules && node scripts/verify-package-files.mjs && pnpm run test:packed-package",
		"typecheck": "node scripts/check-types.mjs"
	},
	"pi": {
		"image": "https://cdn.jsdelivr.net/npm/gentle-pi/assets/gentle-logo-only.png",
		"extensions": [
			"./extensions"
		],
		"themes": [
			"./themes"
		],
		"prompts": [
			"./prompts"
		],
		"skills": [
			"./skills"
		]
	},
	"dependencies": {
		"@earendil-works/pi-ai": "0.87.1",
		"@earendil-works/pi-tui": "0.87.1",
		"@heyhuynhgiabuu/pi-pretty": "0.6.27"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": ">=0.85.1",
		"typebox": "*"
	},
	"peerDependenciesMeta": {
		"@earendil-works/pi-coding-agent": {
			"optional": true
		}
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "0.87.1",
		"@types/node": "^24.13.3",
		"typescript": "^5.9.3"
	},
	"packageManager": "pnpm@11.1.1"
}
